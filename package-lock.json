{
  "name": "iot-sensor",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "iot-sensor",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "tools/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24 <25"
      }
    },
    "apps/server": {
      "name": "@iot-sensor/server",
      "version": "1.0.0",
      "license": "MIT"
    },
    "apps/web": {
      "name": "@iot-sensor/web",
      "version": "1.0.0",
      "license": "MIT"
    },
    "node_modules/@iot-sensor/generator": {
      "resolved": "tools/generator",
      "link": true
    },
    "node_modules/@iot-sensor/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@iot-sensor/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@iot-sensor/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@iot-sensor/shared",
      "version": "1.0.0",
      "license": "MIT"
    },
    "tools/generator": {
      "name": "@iot-sensor/generator",
      "version": "1.0.0",
      "license": "MIT"
    }
  }
}
