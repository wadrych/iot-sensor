{
  "name": "iot-sensor",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "iot-sensor",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "tools/*",
        "packages/*"
      ],
      "devDependencies": {
        "prettier": "^3.9.10"
      },
      "engines": {
        "node": ">=24 <25"
      }
    },
    "apps/server": {
      "name": "@iot-sensor/server",
      "version": "1.0.0",
      "license": "MIT"
    },
    "apps/web": {
      "name": "@iot-sensor/web",
      "version": "1.0.0",
      "license": "MIT"
    },
    "node_modules/@iot-sensor/generator": {
      "resolved": "tools/generator",
      "link": true
    },
    "node_modules/@iot-sensor/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@iot-sensor/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@iot-sensor/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/prettier": {
      "version": "3.9.10",
      "resolved": "https://registry.npmjs.org/prettier/-/prettier-3.9.10.tgz",
      "integrity": "sha512-skGHTH1Yb9QvaTC4hWnRTzEYtCpApF0UMBPz+t/0ZPzP8ihefo/btKd+QA7pUE0fEwA1SbS/NmhyEcstdXOIdA==",
      "dev": true,
      "license": "MIT",
      "bin": {
        "prettier": "bin/prettier.cjs"
      },
      "engines": {
        "node": ">=14"
      },
      "funding": {
        "url": "https://github.com/prettier/prettier?sponsor=1"
      }
    },
    "packages/shared": {
      "name": "@iot-sensor/shared",
      "version": "1.0.0",
      "license": "MIT"
    },
    "tools/generator": {
      "name": "@iot-sensor/generator",
      "version": "1.0.0",
      "license": "MIT"
    }
  }
}
